  <fullTextUrl format="pdf">'.$fullTextUrl.'</fullTextUrl>
  '.$keywords.'
 </record>
</records>';


/*---------------- end XML --------------*/


/*---------------- BibTeX --------------*/

	$BibTeX_autor = '';

	for($j=0; $j<count($FIO_autor_text); $j++){
		if ($j==0){ $BibTeX_autor = $FIO_autor_text[$j];} else{$BibTeX_autor = $BibTeX_autor . ' and ' . $FIO_autor_text[$j];}
	}


	if(!empty($node_xml->field_journal_link['und'][0]['target_id'])){
		$Journal_id = $node_xml->field_journal_link['und'][0]['target_id'];		
		$Journal = node_load($Journal_id);
		if (!empty($Journal->field_year['und'][0]['value'])) {
				$Journal_year = mb_substr($Journal->field_year['und'][0]['value'],0,4);
			} 
		else 
			{
				$Journal_year="";
			}
	}

	$BibTeX_address ="Saratov State University, ul. Astrakhanskaya, 83, Saratov, 410012, Russia";

	$BibTeX_id_name=variable_get("BibTeX_id_name", "");

	$rexultBibTeX = '@article{
	'.$BibTeX_id_name.'-'. $volume . '-' . $issue. '-' .$startPage .',
	author = {'.$BibTeX_autor.'},
	title = {'.$TitlePage.'},
	year = {'.$Journal_year.'},
	journal = {'.$journalTitle.'},
	volume = {'.$volume.'},
	number = {'.$issue.'},
	url = {'.$fullTextUrl.'},
	address = {'.$BibTeX_address.'},
	language = {'.$my_language.'},
	doi = {'.$doi.'},
	pages = {'.$startPage.'--'.$endPage.'},
	issn = {'.$issnPrint.'},
	keywords = {'.$BibTeX_keywords.'},
	abstract = {'.$abstract.'}
}';

/*---------------- End BibTeX ----------*/


/*------------------ JATS -------------*/

$rexult_JATS = '<?xml version="1.0" encoding="UTF-8"?>
<article xmlns:xlink="http://www.w3.org/1999/xlink" article-type="research-article" dtd-version="1.4" xml:lang="en">
    <front>
        <journal-meta>
            <journal-title-group>
                <journal-title xml:lang="ru">  '.$journalTitleRu.'  </journal-title>
            </journal-title-group>
            <journal-id journal-id-type="issn"> '.$issnPrint.' </journal-id>
            <journal-id journal-id-type="eissn"> '.$issnOnline.' </journal-id>
        </journal-meta>
        <article-meta>
            <article-id pub-id-type="doi"> '.$doi.' </article-id>
            <article-id pub-id-type="edn"> '.$edn.' </article-id>
            <article-id pub-id-type="uri"> '.$absolute_url.' </article-id>
            <self-uri> '.$absolute_url.' </self-uri>
            <title-group>
                <article-title xml:lang="ru">'.$TitlePageRu.'</article-title>
                <trans-title-group xml:lang="en">
                    <trans-title>'.$TitlePage.'</trans-title>
                </trans-title-group>
            </title-group>
            <contrib-group>

			</contrib-group>



        </article-meta>
    </front>
</article>';

/*---------------- End JATS ----------*/

  drupal_add_js(drupal_get_path('module', 'biblio_list') . '/js/biblio_list.js');
  drupal_add_css(drupal_get_path('module', 'biblio_list') . '/css/biblio_list.css');

  $path_libraries_fileSaverJs = libraries_get_path('FileSaver.js'). '/FileSaver.min.js';
  drupal_add_js($path_libraries_fileSaverJs);


	drupal_add_js('
	    function downloadXML(){
