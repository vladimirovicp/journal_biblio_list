function company_name($node_uid,$my_language){

	$node_company_name = node_load($node_uid);
	if (!empty($node_company_name->title_field[$my_language][0]['value'])){
		return $node_company_name->title_field[$my_language][0]['value'] . ', ' . $node_company_name->field_address[$my_language][0]['value'];
	} 
}

function  mybiblio_list_shielding_special_characters($text){
		$text2 = strip_tags($text);
		$text2=preg_replace('/&(?!#?[a-z0-9]+;)/', '&amp;', $text2);

		$simbol1="&lt;";
		$simbol2="&quot;";
		$simbol3="&gt;";
		$simbol4="&amp;";

		$healthy = array("<",'"', ">","&");
		$yummy   = array($simbol1, $simbol2, $simbol3,$simbol4);
		$text2 = str_replace($healthy, $yummy, $text2);	
		$text_rezult = str_replace(array("\r\n", "\r", "\n"), ' ', $text2);
		return $text_rezult;		
}


/**
 * Подготовка текста для безопасной вставки в XML (JATS).
 * Вырезает HTML-теги, нормализует уже существующие сущности
 * и экранирует спецсимволы & < > " '.
 */
function mybiblio_list_xml_safe($text) {
	$text = strip_tags($text);
	$text = decode_entities($text);
	return check_plain($text);
}


function international_bases($user_uid){
	$user = user_load($user_uid);

	$field_researcherid = NULL;
	if (isset($user->field_researcherid['und'][0]['value'])) {
		$field_researcherid = $user->field_researcherid['und'][0]['value'];
	}

	$field_spin = NULL;
	if (isset($user->field_spin_elibrary['und'][0]['value'])) {
		$field_spin = $user->field_spin_elibrary['und'][0]['value'];
	}

	$field_scopusid = NULL;
	if (isset($user->field_scopusid['und'][0]['value'])) {
		$field_scopusid = $user->field_scopusid['und'][0]['value'];
	}

	$field_orcid = NULL;
	if (isset($user->field_orcid['und'][0]['value'])) {
		$field_orcid = $user->field_orcid['und'][0]['value'];
	}

	$lines = array();

	if ($field_scopusid !== NULL && $field_scopusid !== '') {
		$lines['scopusid'] = $field_scopusid;
	}
	if ($field_researcherid !== NULL && $field_researcherid !== '') {
		$lines['researcherid'] = $field_researcherid;
	}
	if ($field_orcid !== NULL && $field_orcid !== '') {
		$lines['orcid'] = $field_orcid;
	}
	if ($field_spin !== NULL && $field_spin !== '') {
		$lines['spin'] = $field_spin;
	}

	return $lines;
}

function jats_parse_date($date_raw) {
	$date_part = strtok(trim($date_raw), " T");
	$parts = explode('-', $date_part);
	if (count($parts) === 3) {
		return array(
			'iso'   => $date_part,
			'year'  => $parts[0],
			'month' => $parts[1],
			'day'   => $parts[2],
		);
	}
	return NULL;
}

function read_literature($node_xml, $lang) {
	$lang = empty($node_xml->field_literature[$lang]) ? 'und' : $lang;
	$items = $node_xml->field_literature[$lang];
	if (empty($items[0]['value'])) {
		return array();
	}

	$html = $items[0]['value'];
	if (!preg_match_all('/<li\b[^>]*>(.*?)<\/li>/siu', $html, $matches)) {
		return array();
	}

	$result = array();
	foreach ($matches[1] as $li) {
		$text = html_entity_decode($li, ENT_QUOTES | ENT_HTML5, 'UTF-8');
		$text = strip_tags($text);
		$text = trim($text);
		$result[] = array('text' => $text);
	}

	return $result;
}