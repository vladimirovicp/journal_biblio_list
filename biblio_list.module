	';    

}


function FIO_autor_node($user_uid,$my_language){
	$info_autor =  user_load($user_uid);
	if ($my_language == 'ru') { $other_language = 'en';} else { $other_language = 'ru';}

		if (isset($info_autor->field_lastname[$my_language]['0']['value'])){
			$field_lastname=$info_autor->field_lastname[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_lastname['ru']['0']['value'])){$field_lastname=$info_autor->field_lastname['ru']['0']['value'];}
			if (isset($info_autor->field_lastname['en']['0']['value'])){$field_lastname=$info_autor->field_lastname['en']['0']['value'];}	
		}	


		if (isset($info_autor->field_name2[$my_language]['0']['value'])){
			$Name_autor=$info_autor->field_name2[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_name2['ru']['0']['value'])){$Name_autor=$info_autor->field_name2['ru']['0']['value'];}
			if (isset($info_autor->field_name2['en']['0']['value'])){$Name_autor=$info_autor->field_name2['en']['0']['value'];}	
		}			

		$Otchestvo_autor = '';

		if (isset($info_autor->field_middle_name[$my_language]['0']['value'])){
			$Otchestvo_autor=$info_autor->field_middle_name[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_middle_name['ru']['0']['value'])){
				$Otchestvo_autor=$info_autor->field_middle_name['ru']['0']['value'];
			}
			if (isset($info_autor->field_middle_name['en']['0']['value'])){
				$Otchestvo_autor=$info_autor->field_middle_name['en']['0']['value'];
			}	
		}
		$FIO = $field_lastname . ', ' . $Name_autor . ' ' . $Otchestvo_autor;
	return $FIO;		
}


function FIO_autor_node_split($user_uid,$my_language){
	$info_autor =  user_load($user_uid);
	if ($my_language == 'ru') { $other_language = 'en';} else { $other_language = 'ru';}

		if (isset($info_autor->field_lastname[$my_language]['0']['value'])){
			$field_lastname=$info_autor->field_lastname[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_lastname['ru']['0']['value'])){$field_lastname=$info_autor->field_lastname['ru']['0']['value'];}
			if (isset($info_autor->field_lastname['en']['0']['value'])){$field_lastname=$info_autor->field_lastname['en']['0']['value'];}	
		}	


		if (isset($info_autor->field_name2[$my_language]['0']['value'])){
			$Name_autor=$info_autor->field_name2[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_name2['ru']['0']['value'])){$Name_autor=$info_autor->field_name2['ru']['0']['value'];}
			if (isset($info_autor->field_name2['en']['0']['value'])){$Name_autor=$info_autor->field_name2['en']['0']['value'];}	
		}			

		$Otchestvo_autor = '';

		if (isset($info_autor->field_middle_name[$my_language]['0']['value'])){
			$Otchestvo_autor=$info_autor->field_middle_name[$my_language]['0']['value'];
		} else {	
			if (isset($info_autor->field_middle_name['ru']['0']['value'])){
				$Otchestvo_autor=$info_autor->field_middle_name['ru']['0']['value'];
			}
			if (isset($info_autor->field_middle_name['en']['0']['value'])){
				$Otchestvo_autor=$info_autor->field_middle_name['en']['0']['value'];
			}	
		}

	if ($Otchestvo_autor != '') {
		$given_names = $Name_autor . ' ' . $Otchestvo_autor;
	} else {
		$given_names = $Name_autor;
	}

	return array(
		'surname'     => $field_lastname,
		'given_names' => $given_names,
	);		
}



function company_autor_node_id($company_uid,$my_language){
	$info_autor =  user_load($company_uid);
	if (!empty($info_autor->field_company_link['und'])){
		return $info_autor->field_company_link['und'][0]['target_id'];
	} 
}

function company_name($node_uid,$my_language){

	$node_company_name = node_load($node_uid);
	if (!empty($node_company_name->title_field[$my_language][0]['value'])){
		return $node_company_name->title_field[$my_language][0]['value'] . ', ' . $node_company_name->field_address[$my_language][0]['value'];
	} 
}

function  mybiblio_list_shielding_special_characters($text){
		$text2 = strip_tags($text);
		$text2=preg_replace('/&(?!#?[a-z0-9]+;)/', '&amp;', $text2);

		$simbol1="&lt;";
		$simbol2="&quot;";
		$simbol3="&gt;";
		$simbol4="&amp;";

		$healthy = array("<",'"', ">","&");
		$yummy   = array($simbol1, $simbol2, $simbol3,$simbol4);
		$text2 = str_replace($healthy, $yummy, $text2);	
		$text_rezult = str_replace(array("\r\n", "\r", "\n"), ' ', $text2);
		return $text_rezult;		
}