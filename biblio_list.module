			$name_keywords = $term->name;
	  		$keywords = $keywords . '
    <keyword>' . $name_keywords . '</keyword>';

    		if ($i==0){$BibTeX_keywords=$name_keywords;}else{$BibTeX_keywords= $BibTeX_keywords .','. $name_keywords;}
	  	}
	  	$keywords = $keywords . '
  </keywords>';
	  }
	$rezultXML ='<?xml version="1.0" encoding="UTF-8"?>
<records>
 <record>
  <language>eng</language>
  <publisher>Saratov State University</publisher>
  <journalTitle>'.$journalTitle.'</journalTitle>
