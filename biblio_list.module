	'Редакторская заметка' => 'editorial',
	'Рецензия' => 'book-review',
	'Материалы конференции' => 'conference-paper',
	'Краткое сообщение' => 'brief-report',
	'Обзорная статья' => 'review-article',
	'Аннотация' => 'abstract',
	'Научный отчет' => 'report',
	'Переписка' => 'letter',
	'Персоналии' => 'tribute',
	'Некролог' => 'obituary',
);
$article_type_atribbute = isset($art_type_map[trim($artType)]) ? $art_type_map[trim($artType)] : 'other';

// ref-list для JATS (список литературы)
$JATS_refs = '';
$refs_ru = read_literature($node_xml, 'ru');
$refs_en = read_literature($node_xml, 'en');
$refs_count = max(count($refs_ru), count($refs_en));
for ($i = 0; $i < $refs_count; $i++) {
	$JATS_refs .= '
            <ref id="ref' . ($i + 1) . '">';
	if (isset($refs_ru[$i]['text'])) {
		$JATS_refs .= '
                <mixed-citation xml:lang="ru">' . mybiblio_list_xml_safe($refs_ru[$i]['text']) . '</mixed-citation>';
	}
	if (isset($refs_en[$i]['text'])) {
		$JATS_refs .= '
                <mixed-citation xml:lang="en">' . mybiblio_list_xml_safe($refs_en[$i]['text']) . '</mixed-citation>';
	}
	$JATS_refs .= '
            </ref>';
}

