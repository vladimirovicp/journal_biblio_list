<?php

function biblio_list_block_info() {

  $blocks = [];

  $blocks['cite article block'] = [
    'info'  => t('Biblio list block '),
  ];

  return $blocks;
}

function biblio_list_block_view($delta = '') {

   $block = array();

  switch ($delta) {

    case 'cite article block':

      $block['subject'] = t('Cite');
      $block['content'] = mybiblio_list_block_content();

      break;
  }


  return $block;
}


function mybiblio_list_block_content() {

  if (arg(0) == 'node' && is_numeric(arg(1))) {$nid = arg(1);}

  $node_xml = node_load($nid);

  //dpm($node_xml);

// Если статья 
  	if(isset($node_xml->field_early_access['und'][0]['value'])){
  			if($node_xml->field_early_access['und'][0]['value'] == 1){
					return '';
				}
				
		}

	// Получить только алиас (человекопонятный URL без домена и слэша, например: my-alias)
	$alias = drupal_get_path_alias('node/' . $nid);
	$absolute_url = url('node/' . $nid, array('absolute' => TRUE));

	$journalTitle = variable_get("namesite_citation_en_en", "");
	$journalTitleRu = variable_get("namesite_citation_ru_ru", "");
	$issnPrint = variable_get("issnPrint_citation", "");
	$issnOnline = variable_get("issnOnline_citation", "");

//   edn


/*---------------- XML --------------*/
  //Заголовок
  if (!empty($node_xml->title_field['en'][0]['value'])) {
  	$TitlePage = $node_xml->title_field['en'][0]['value'];
  } else{ $TitlePage = '';}

	$TitlePageRu = '';
	if (!empty($node_xml->title_field['ru'][0]['value'])) {
		$TitlePageRu = $node_xml->title_field['ru'][0]['value'];
	}

	if(!empty($node_xml->field_journal_link['und'][0]['target_id'])){

		$Number_Node_date = $node_xml->field_journal_link['und'][0]['target_id'];		
		$nodeview = node_load($Number_Node_date);
		
		if(!empty($nodeview->field_date_publication['und'][0]['value'])){
			$publicationDate = $nodeview->field_date_publication['und'][0]['value'];
			$publicationDate = '<publicationDate>'.strtok($publicationDate, ' ').'</publicationDate>';			
		} else {$publicationDate = '<publicationDate></publicationDate>';}




		//Том
		if(!empty($nodeview->field_volume['und'][0]['value'])){
			$volume = $nodeview->field_volume['und'][0]['value'];
		} else { $volume = '';}


		//Выпуск
		if(!empty($nodeview->field_number_str['und'][0]['value'])){
			if(!empty($nodeview->field_through_number['und'][0]['value'])){
				$issue = $nodeview->field_number_str['und'][0]['value'] . ' (' . $nodeview->field_through_number['und'][0]['value'] . ')';
			} else {
				$issue = $nodeview->field_number_str['und'][0]['value'];
			}
		} else {
			if(!empty($nodeview->field_number['und'][0]['value'])){
				if(!empty($nodeview->field_through_number['und'][0]['value'])){
					$issue = $nodeview->field_number['und'][0]['value'] . ' (' . $nodeview->field_through_number['und'][0]['value'] . ')';
				} else {
					$issue = $nodeview->field_number['und'][0]['value'];
				}
					
			} else {$issue = '';}	
		}

		

	}

		// Страница начала
	  if (!empty($node_xml->field_page_no['und'][0]['value'])) {
	  	$startPage = $node_xml->field_page_no['und'][0]['value'];
	  } else{ $startPage = '';}	

	   //Страница завершения
	  if (!empty($node_xml->field_page_no_to['und'][0]['value'])) {
	  	$endPage= $node_xml->field_page_no_to['und'][0]['value'];
	  } else{ $endPage = '';}	


	  // Doi
	  if (!empty($node_xml->field_doi['und'][0]['value'])) {
	  	$doi= $node_xml->field_doi['und'][0]['value'];
	  } else{ $doi = '';}

	//   edn
	$edn="";
	if (!empty($node_xml->field_edn['und'][0]['value'])) {
		$edn= $node_xml->field_edn['und'][0]['value'];
	} 
	




	  $my_language ='en';
	  $FIO_autor_text = array();
	  $affiliationId = array();
	  $company_count=0;


	  if (!empty($node_xml->field_autor['und'][0]['target_id'])) {
	  	for ($i = 0; $i < count($node_xml->field_autor['und']); $i++) {

	  		$user_uid = $node_xml->field_autor['und'][$i]['target_id'];
	  		$FIO_autor_text[$i] = FIO_autor_node($user_uid,$my_language);
	  		$Company_autor_id[$i] = company_autor_node_id($user_uid,$my_language);


	  		if ($company_count == 0) {

	  			$Company_list[$company_count] = $Company_autor_id[$i];
	  			$company_count = $company_count + 1;
	  			$affiliationId[$i] = $company_count;

	  		} else{
	  			if (!in_array($Company_autor_id[$i], $Company_list)) {
				   	$Company_list[$company_count] = $Company_autor_id[$i];
	  				$company_count = $company_count + 1;
	  				$affiliationId[$i] = $company_count;
				} else {
					for ($k=0; $k<count($Company_list); $k++){
						if ($Company_list[$k] == $Company_autor_id[$i]){
							$affiliationId[$i] = $k+1;
						}
					}

				}
	  		}
	  	}

	  		$authors='<authors>';



	  			for($j=0; $j<count($FIO_autor_text); $j++){
	  				$authors = $authors . '
    <author>
      <name>' . $FIO_autor_text[$j] . '</name>
      <affiliationId>' . $affiliationId[$j] . '</affiliationId>
    </author>';
	  			}
	  		$authors = $authors . '
  </authors>';
  			$authors = $authors . '
  <affiliationsList>';
  		for ($i = 0; $i < count($Company_list); $i++) {
  	$authors = $authors . '
    <affiliationName affiliationId="' . ($i+1) . '">'.company_name($Company_list[$i],$my_language).'</affiliationName>';  			
  		}
  			$authors = $authors . '
    </affiliationsList>';
	  } else {
	  	$authors = '';
	  }

	  if (!empty($node_xml->body['en'][0]['value'])) {
	  	$abstract = mybiblio_list_xml_safe($node_xml->body['en'][0]['value']);
	  } else{ $abstract = '';}

	if (!empty($node_xml->field_text_pdf['und'][0]['uri'])) {
		$fullTextUrl= file_create_url($node_xml->field_text_pdf['und'][0]['uri']);
	} else{ $fullTextUrl = '';}
		$keywords='';
		$BibTeX_keywords='';
	  if (!empty($node_xml->field_key_words[$my_language][0]['tid'])) {
	  	$keywords = '<keywords language="eng">';
	  	for ($i = 0; $i < count($node_xml->field_key_words[$my_language]); $i++) {

	  		$term = taxonomy_term_load($node_xml->field_key_words[$my_language][$i]['tid']);
			$name_keywords = $term->name;
	  		$keywords = $keywords . '
    <keyword>' . $name_keywords . '</keyword>';

    		if ($i==0){$BibTeX_keywords=$name_keywords;}else{$BibTeX_keywords= $BibTeX_keywords .','. $name_keywords;}
	  	}
	  	$keywords = $keywords . '
  </keywords>';
	  }
	$rezultXML ='<?xml version="1.0" encoding="UTF-8"?>
<records>
 <record>
  <language>eng</language>
  <publisher>Saratov State University</publisher>
  <journalTitle>'.$journalTitle.'</journalTitle>
  <issn>'.$issnPrint.'</issn>
  <eissn>'.$issnOnline.'</eissn>
  '.$publicationDate.' 
  <volume>'.$volume.'</volume>
  <issue>'.$issue.'</issue>
  <startPage>'.$startPage .'</startPage>
  <endPage>'.$endPage.'</endPage>
  <doi>'.$doi.'</doi>
  <documentType>article</documentType>
  <title language="eng">'.$TitlePage.'</title>
  '.$authors.'
  <abstract language="eng">'.$abstract.'</abstract>
  <fullTextUrl format="pdf">'.$fullTextUrl.'</fullTextUrl>
  '.$keywords.'
 </record>
</records>';


/*---------------- end XML --------------*/


/*---------------- BibTeX --------------*/

	$BibTeX_autor = '';

	for($j=0; $j<count($FIO_autor_text); $j++){
		if ($j==0){ $BibTeX_autor = $FIO_autor_text[$j];} else{$BibTeX_autor = $BibTeX_autor . ' and ' . $FIO_autor_text[$j];}
	}


	if(!empty($node_xml->field_journal_link['und'][0]['target_id'])){
		$Journal_id = $node_xml->field_journal_link['und'][0]['target_id'];		
		$Journal = node_load($Journal_id);
		if (!empty($Journal->field_year['und'][0]['value'])) {
				$Journal_year = mb_substr($Journal->field_year['und'][0]['value'],0,4);
			} 
		else 
			{
				$Journal_year="";
			}
	}

	$BibTeX_address ="Saratov State University, ul. Astrakhanskaya, 83, Saratov, 410012, Russia";

	$BibTeX_id_name=variable_get("BibTeX_id_name", "");

	$rexultBibTeX = '@article{
	'.$BibTeX_id_name.'-'. $volume . '-' . $issue. '-' .$startPage .',
	author = {'.$BibTeX_autor.'},
	title = {'.$TitlePage.'},
	year = {'.$Journal_year.'},
	journal = {'.$journalTitle.'},
	volume = {'.$volume.'},
	number = {'.$issue.'},
	url = {'.$fullTextUrl.'},
	address = {'.$BibTeX_address.'},
	language = {'.$my_language.'},
	doi = {'.$doi.'},
	pages = {'.$startPage.'--'.$endPage.'},
	issn = {'.$issnPrint.'},
	keywords = {'.$BibTeX_keywords.'},
	abstract = {'.$abstract.'}
}';

/*---------------- End BibTeX ----------*/


/*------------------ JATS -------------*/


$JATS_copyright_statement = '';
$JATS_copyright_statement_en = '';
$JATS_copyright_holders = array();
$JATS_copyright_holders_en = array();

// Формирование contrib-group для JATS
$JATS_contrib = '';
if (!empty($node_xml->field_autor['und'][0]['target_id'])) {
	for ($i = 0; $i < count($node_xml->field_autor['und']); $i++) {
		$user_uid = $node_xml->field_autor['und'][$i]['target_id'];
		$name_ru = FIO_autor_node_split($user_uid, 'ru');
		$name_en = FIO_autor_node_split($user_uid, 'en');
		$bases = international_bases($user_uid);

		// Формирование строки "Фамилия И. О." для copyright-statement и copyright-holder
		$copyright_initials = '';
		$given_name_parts = explode(' ', trim($name_ru['given_names']));
		foreach ($given_name_parts as $given_name_part) {
			if ($given_name_part !== '') {
				$copyright_initials .= mb_substr($given_name_part, 0, 1) . '. ';
			}
		}
		$copyright_initials = trim($copyright_initials);
		if ($copyright_initials !== '') {
			$JATS_copyright_holders[] = $name_ru['surname'] . ' ' . $copyright_initials;
		} else {
			$JATS_copyright_holders[] = $name_ru['surname'];
		}

		// Формление английской версии "Surname I. O." для copyright-statement и copyright-holder
		$copyright_initials_en = '';
		$given_name_parts_en = explode(' ', trim($name_en['given_names']));
		foreach ($given_name_parts_en as $given_name_part_en) {
			if ($given_name_part_en !== '') {
				$copyright_initials_en .= mb_substr($given_name_part_en, 0, 1) . '. ';
			}
		}
		$copyright_initials_en = trim($copyright_initials_en);
		if ($copyright_initials_en !== '') {
			$JATS_copyright_holders_en[] = $name_en['surname'] . ' ' . $copyright_initials_en;
		} else {
			$JATS_copyright_holders_en[] = $name_en['surname'];
		}

		$JATS_contrib .= '
                <contrib contrib-type="author">
                    <name>
                        <surname>' . $name_ru['surname'] . '</surname>
                        <given-names>' . $name_ru['given_names'] . '</given-names>
                    </name>
                    <name-alternatives>
                        <name xml:lang="ru">
                            <surname>' . $name_ru['surname'] . '</surname>
                            <given-names>' . $name_ru['given_names'] . '</given-names>
                        </name>
                        <name xml:lang="en">
                            <surname>' . $name_en['surname'] . '</surname>
                            <given-names>' . $name_en['given_names'] . '</given-names>
                        </name>
                    </name-alternatives>
                    <xref ref-type="aff" rid="aff' . $affiliationId[$i] . '"/>';
		if (!empty($bases['scopusid'])) {
			$JATS_contrib .= '
                    <contrib-id contrib-id-type="scopusid">' . $bases['scopusid'] . '</contrib-id>';
		}	
		if (!empty($bases['researcherid'])) {
			$JATS_contrib .= '
                    <contrib-id contrib-id-type="researcherid">' . $bases['researcherid'] . '</contrib-id>';
		}				
		if (!empty($bases['orcid'])) {
			$JATS_contrib .= '
                    <contrib-id contrib-id-type="orcid">' . $bases['orcid'] . '</contrib-id>';
		}
		if (!empty($bases['spin'])) {
			$JATS_contrib .= '
                    <contrib-id contrib-id-type="spin">' . $bases['spin'] . '</contrib-id>';
		}
		$JATS_contrib .= '</contrib>';
	}

	for ($i = 0; $i < count($Company_list); $i++) {
		$company_node = node_load($Company_list[$i]);
		$company_title_en = '';
		$company_title_ru = '';
		if (!empty($company_node->title_field['en'][0]['value'])) {
			$company_title_en = $company_node->title_field['en'][0]['value'];
		}
		if (!empty($company_node->title_field['ru'][0]['value'])) {
			$company_title_ru = $company_node->title_field['ru'][0]['value'];
		}

		$company_city_en = '';
		$company_city_ru = '';
		if (!empty($company_node->field_city_link['und'][0]['tid'])) {
			$city_term = taxonomy_term_load($company_node->field_city_link['und'][0]['tid']);


			

			// $city_name_ru = i18n_string_translate($string_name, $city_term->name, array('langcode' => 'ru'));
			// $city_name_en = i18n_string_translate($string_name, $city_term->name, array('langcode' => 'en'));

			// dpm($city_term);

			// dpm($city_name_ru);
			//dpm($city_name_en);

			if (!empty($city_term->name_field['en'][0]['value'])) {
				$company_city_en = $city_term->name_field['en'][0]['value'];
			} else {

				$string_name = 'taxonomy:term:' . $city_term->tid . ':name';
				$city_name_en = i18n_string_translate($string_name, $city_term->name, array('langcode' => 'en'));

				$company_city_en = $city_name_en;

				// $company_city_en = $city_term->name;
			}
			if (!empty($city_term->name_field['ru'][0]['value'])) {
				$company_city_ru = $city_term->name_field['ru'][0]['value'];
			} else {
				$company_city_ru = $city_term->name;
			}
		}

		$company_country_en = '';
		$company_country_ru = '';
		
		if (!empty($company_node->field_country['und'][0]['tid'])) {
			$country_term = taxonomy_term_load($company_node->field_country['und'][0]['tid']);
			if (!empty($country_term->name_field['en'][0]['value'])) {
				$company_country_en = $country_term->name_field['en'][0]['value'];
			} else {

				$string_name_country = 'taxonomy:term:' . $country_term->tid . ':name';
				$country_name_en = i18n_string_translate($string_name_country,$country_term->name, array('langcode' => 'en'));

				$company_country_en = $country_name_en;

				// $company_country_en = $country_term->name;
			}
			if (!empty($country_term->name_field['ru'][0]['value'])) {
				$company_country_ru = $country_term->name_field['ru'][0]['value'];
			} else {
				$company_country_ru = $country_term->name;
			}
		} else {
			
			$country_term = '';
			
			if (!empty($company_node->field_country['ru'][0]['tid'])) {
				$country_term = taxonomy_term_load($company_node->field_country['ru'][0]['tid']);
			} else{
				if (!empty($company_node->field_country['en'][0]['tid'])) {
					$country_term = taxonomy_term_load($company_node->field_country['en'][0]['tid']);
				}
			}
			
			if($country_term){
				$company_country_ru = $country_term->name;
				
				$string_name_country = 'taxonomy:term:' . $country_term->tid . ':name';
				$country_name_en = i18n_string_translate($string_name_country,$country_term->name, array('langcode' => 'en'));
				$company_country_en = $country_name_en;
			}
		}

		$JATS_contrib .= '
                <aff-alternatives id="aff' . ($i + 1) . '">
                    <aff>
                        <institution xml:lang="en">' . $company_title_en . '</institution>
						<city xml:lang="en">' . $company_city_en .'</city>
						<country xml:lang="en">' . $company_country_en . '</country>
                    </aff>
                    <aff>
                        <institution xml:lang="ru">' . $company_title_ru . '</institution>
						<city xml:lang="ru">' . $company_city_ru . '</city>
						<country xml:lang="ru">' . $company_country_ru . '</country>
                    </aff>
                </aff-alternatives>';
	}
}

// Если авторы отсутствуют — анонимный автор
if ($JATS_contrib == '') {
	$JATS_contrib = '
                <contrib contrib-type="author">
                    <anonymous/>
                </contrib>';
}

// Формирование copyright-statement, copyright-year и copyright-holder для JATS
$JATS_copyright_year = '';
if (!empty($node_xml->field_date_received['und'][0]['value'])) {
	$copyright_date = jats_parse_date($node_xml->field_date_received['und'][0]['value']);
	if ($copyright_date) {
		$JATS_copyright_year = $copyright_date['year'];
	}
}

if (!empty($JATS_copyright_holders) && $JATS_copyright_year !== '') {
	$JATS_copyright_holder = implode(', ', $JATS_copyright_holders);
	$JATS_copyright_statement = '
				<copyright-statement>© ' . $JATS_copyright_holder . ', ' . $JATS_copyright_year . '</copyright-statement>
				<copyright-year>' . $JATS_copyright_year . '</copyright-year>
				<copyright-holder>' . $JATS_copyright_holder . '</copyright-holder>';
}

if (!empty($JATS_copyright_holders_en) && $JATS_copyright_year !== '') {
	$JATS_copyright_holder_en = implode(', ', $JATS_copyright_holders_en);
	$JATS_copyright_statement_en = '
				<copyright-statement>© ' . $JATS_copyright_holder_en . ', ' . $JATS_copyright_year . '</copyright-statement>
				<copyright-year>' . $JATS_copyright_year . '</copyright-year>
				<copyright-holder>' . $JATS_copyright_holder_en . '</copyright-holder>';
}

// Если copyright не сформирован — права университета по умолчанию
if ($JATS_copyright_statement == '') {
	$JATS_copyright_statement = '
				<copyright-statement>© ФГБОУ ВО «Саратовский национальный исследовательский государственный университет имени Н.Г. Чернышевского», ' . $JATS_copyright_year . '</copyright-statement>
				<copyright-year>' . $JATS_copyright_year . '</copyright-year>
				<copyright-holder>ФГБОУ ВО «Саратовский национальный исследовательский государственный университет имени Н.Г. Чернышевского»</copyright-holder>';
}

if ($JATS_copyright_statement_en == '') {
	$JATS_copyright_statement_en = '
				<copyright-statement>© Saratov State University, ' . $JATS_copyright_year . '</copyright-statement>
				<copyright-year>' . $JATS_copyright_year . '</copyright-year>
				<copyright-holder>Saratov State University</copyright-holder>';
}

// Дата публикации для JATS (узел статьи)
$JATS_pub_date = '';
if (!empty($node_xml->field_published['und'][0]['value'])) {
	$d = jats_parse_date($node_xml->field_published['und'][0]['value']);
	if ($d) {
		$JATS_pub_date = '
            <pub-date iso-8601-date="' . $d['iso'] . '" pub-type="epub">
                <day>' . $d['day'] . '</day>
                <month>' . $d['month'] . '</month>
                <year>' . $d['year'] . '</year>
            </pub-date>';
	}
}

// История дат для JATS (узел статьи)
$JATS_date_received = '';
if (!empty($node_xml->field_date_received['und'][0]['value'])) {
	$d = jats_parse_date($node_xml->field_date_received['und'][0]['value']);
	if ($d) {
		$JATS_date_received = '
                <date date-type="received" iso-8601-date="' . $d['iso'] . '">
                    <day>' . $d['day'] . '</day>
                    <month>' . $d['month'] . '</month>
                    <year>' . $d['year'] . '</year>
                </date>';
	}
}

$JATS_date_accepted = '';
if (!empty($node_xml->field_accepted['und'][0]['value'])) {
	$d = jats_parse_date($node_xml->field_accepted['und'][0]['value']);
	if ($d) {
		$JATS_date_accepted = '
                <date date-type="accepted" iso-8601-date="' . $d['iso'] . '">
                    <day>' . $d['day'] . '</day>
                    <month>' . $d['month'] . '</month>
                    <year>' . $d['year'] . '</year>
                </date>';
	}
}

$JATS_history = '';
if ($JATS_date_received != '' || $JATS_date_accepted != '') {
	$JATS_history = '
            <history>' . $JATS_date_received . $JATS_date_accepted . '
            </history>';
}

// Аннотация на русском для JATS
$abstract_ru = '';
if (!empty($node_xml->body['ru'][0]['value'])) {
	$abstract_ru = mybiblio_list_xml_safe($node_xml->body['ru'][0]['value']);
}

// Ключевые слова для JATS (оба языка)
$JATS_kwd_ru = '';
if (!empty($node_xml->field_key_words['ru'][0]['tid'])) {
	$JATS_kwd_ru = '
            <kwd-group xml:lang="ru">';
	for ($i = 0; $i < count($node_xml->field_key_words['ru']); $i++) {
		$term = taxonomy_term_load($node_xml->field_key_words['ru'][$i]['tid']);
		$JATS_kwd_ru .= '
                <kwd>' . $term->name . '</kwd>';
	}
	$JATS_kwd_ru .= '
            </kwd-group>';
}

$JATS_kwd_en = '';
if (!empty($node_xml->field_key_words['en'][0]['tid'])) {
	$JATS_kwd_en = '
            <kwd-group xml:lang="en">';
	for ($i = 0; $i < count($node_xml->field_key_words['en']); $i++) {
		$term = taxonomy_term_load($node_xml->field_key_words['en'][$i]['tid']);
		$JATS_kwd_en .= '
                <kwd>' . $term->name . '</kwd>';
	}
	$JATS_kwd_en .= '
            </kwd-group>';
}

// Тип статьи для JATS (field_typersci)
$artType = 'Научная статья';
if (!empty($node_xml->field_typersci['und'][0]['tid'])) {
